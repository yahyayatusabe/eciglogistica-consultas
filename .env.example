# Copia este archivo como .env  (Windows: copy .env.example .env  ·  Mac/Linux: cp .env.example .env)
# Si no existe .env, docker-compose usa estos mismos valores por defecto.

# --- Base de datos ---
DB_ROOT_PASSWORD=root_local
DB_NAME=eciglogistica
DB_USER=ecig_user
DB_PASSWORD=ecig_pass

# --- IA ---
# Vacío = modo simulado (clasificación por palabras clave, sin coste).
# Con clave = IA real. Por defecto Groq (gratis): https://console.groq.com/keys
AI_API_KEY=
AI_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.groq.com/openai/v1

# Para usar OpenAI en lugar de Groq:
# AI_BASE_URL=https://api.openai.com/v1
# AI_MODEL=gpt-4o-mini
